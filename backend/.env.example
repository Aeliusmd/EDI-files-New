# Port is set via deploy.env (BACKEND_PORT) at the repo root, not here.
# CORS_ORIGINS below is only used when running uvicorn manually (bypassing
# scripts/start.ps1, which derives and injects this from deploy.env's
# FRONTEND_PORT automatically).
CORS_ORIGINS=http://localhost:7008,http://127.0.0.1:7008

# Optional MySQL save support.
# MYSQL_URL=mysql+pymysql://root:password@localhost:3306/edi_835_converter

# JWT auth for external ERA lookup (client_id:secret pairs, comma-separated)
JWT_SECRET=your_256bit_random_secret_here
JWT_CLIENTS=outside_team:your_client_secret_here
JWT_EXPIRE_SECONDS=3600
JWT_REFRESH_EXPIRE_SECONDS=86400

# MongoDB (ERA payments store + refresh token jti tracking)
MONGO_URI=mongodb://10.103.0.201:27017
MONGO_DB=edi_835
MONGO_COLLECTION=era_payments
MONGO_REFRESH_COLLECTION=auth_refresh_tokens
# Separate Mongo database for 277 / 999 (same server as MONGO_URI)
MONGO_277_999_DB=edi_277_999
MONGO_277_COLLECTION=claim_status_277
MONGO_999_COLLECTION=functional_ack_999

# Rate limiting (requests per window)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Audit log file path
AUDIT_LOG_PATH=audit.log

# Billing API (invoice data lookup per claim_id + service_date, embedded into era_payments docs)
BILLING_API_ENABLED=true
BILLING_API_BASE_URL=http://10.103.0.203:94/api/BillingManagement/Billing
BILLING_API_TIMEOUT=15
BILLING_API_RETRIES=2

# Circuit breaker — after N consecutive server-health failures (timeout/5xx/connection
# errors, NOT 404/400), stop calling the Billing API for a cooldown period.
BILLING_API_BREAKER_THRESHOLD=5
BILLING_API_BREAKER_COOLDOWN_SECONDS=60

# SQL Server sync for 277/999 -> Edi* tables + BillingHeadersHistory (835 unchanged)
SQL_SYNC_ENABLED=true
CLINIC_DB_SERVER=10.103.0.211
CLINIC_DB_NAME=ClaudMD_Development_Sithum
CLINIC_DB_USER=testuser
CLINIC_DB_PASSWORD=Test@123
CLINIC_DB_DRIVER=ODBC Driver 17 for SQL Server
SQL_CREATED_USER_ID=1
SQL_RECORD_STATUS_ID=1
