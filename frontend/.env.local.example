# Leave this EMPTY (or unset entirely). The UI then calls relative paths like
# "/api/edi/parse", which the browser sends to whatever port the frontend is
# running on. next.config.mjs's rewrite rule forwards those internally to the
# backend (see NEXT_SERVER_API_BASE_URL, set automatically by scripts/start.ps1
# from deploy.env — no manual editing needed here).
#
# Only set this to an absolute URL if the browser must reach the backend on a
# DIFFERENT host than the one serving this frontend (rare — breaks the
# single-port setup, since the browser would call the backend directly).
NEXT_PUBLIC_API_BASE_URL=
